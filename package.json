{
  "name": "nollywoodvideo-api",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for NollywoodVideo, a video distribution platform for Nollywood films",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm run dev --prefix frontend",
    "client:install": "npm install --prefix frontend",
    "client:build": "npm run build --prefix frontend",
    "dev": "concurrently -n \"api,web\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "build": "npm run client:install && npm run client:build",
    "postinstall": "npm run client:install"
  },
  "keywords": [
    "nollywood",
    "video",
    "streaming",
    "express",
    "mysql"
  ],
  "author": "NollywoodVideo",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.0",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}