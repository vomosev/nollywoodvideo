# ---------------------------------------------------------------------------
# NollywoodVideo — Frontend (Next.js) environment example
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` inside the `frontend/` directory before
# running `npm run dev` or `npm run build`:
#
#   cp .env.example .env.local
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# This file must never contain real secrets — the frontend talks to the API
# using session cookies, so no API keys are required here.
# ---------------------------------------------------------------------------

# Base URL of the Express API used by the Next.js client at runtime.
# Production deployment (API terminates TLS itself on port 4110):
NEXT_PUBLIC_API_BASE_URL=https://nollywoodvideo-api.arx-app.com:4110

# Local development example (uncomment and adjust if running the API locally):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4110