# ---------------------------------------------------------------------------
# NollywoodVideo API — example environment file
# Copy to .env and fill in values for your environment:
#   cp .env.example .env
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# Port the Express API binds to (production deploy uses 4110)
PORT=4110

# Node environment: development | production
NODE_ENV=production

# --- TLS -------------------------------------------------------------------
# When 'true' the API terminates TLS itself using the paths below.
# Set to 'false' to serve plain HTTP (e.g. behind a reverse proxy locally).
SSL_ENABLED=true

# Absolute path to the TLS certificate file
SSL_CERT_PATH=/home/arx-app/backends/certs/certificate.crt

# Absolute path to the TLS private key file
SSL_KEY_PATH=/home/arx-app/backends/certs/private.key

# Optional absolute path to a CA chain bundle (leave blank if unused)
SSL_CA_PATH=

# --- MySQL database --------------------------------------------------------
# Host name of the MySQL server
DB_HOST=localhost

# MySQL user name
DB_USER=nollywoodvideo_user

# MySQL password (placeholder — replace with your own)
DB_PASSWORD=change_me_db_password

# MySQL database name (create it and load schema.sql before starting)
DB_NAME=nollywoodvideo

# --- Sessions --------------------------------------------------------------
# Secret used to sign the 'nv.sid' session cookie.
# Generate a long random string, e.g.: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_string

# Cookie domain shared by the frontend and API so the session cookie is sent
# cross-subdomain. Leave blank to scope the cookie to the API host only.
SESSION_COOKIE_DOMAIN=.arx-app.com

# --- CORS ------------------------------------------------------------------
# Any request Origin whose hostname ends with this suffix is allowed
# (credentials are enabled, so wildcard origins are not used).
CORS_ALLOWED_SUFFIX=.arx-app.com